{
  "uid": "__UID__",
  "title": "__TITLE__",
  "tags": [
    "forgejo",
    "forgejo-operator"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "icon": "doc",
      "url": "__RUNBOOKS__/README.md",
      "targetBlank": true,
      "tooltip": "Runbooks of the Forgejo alerts"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__NAMESPACE__",
        "hide": 2
      },
      {
        "name": "forgejo",
        "type": "constant",
        "query": "__NAME__",
        "hide": 2
      },
      {
        "name": "job",
        "type": "constant",
        "query": "__JOB__",
        "hide": 2
      },
      {
        "name": "slo_window",
        "type": "constant",
        "query": "__SLO_WINDOW__",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Forgejo targets up",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Forgejo pods successfully scraped by Prometheus.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{namespace=\"$namespace\", job=\"$job\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Ready",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Ready condition as reported by the operator.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_operator_instance_ready{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "index": 1
                },
                "1": {
                  "text": "Ready",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Version",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Version reported by Forgejo's gitea_build_info metric.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (version) (gitea_build_info{namespace=\"$namespace\", job=\"$job\"})",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Health check failures (1h)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Failed /api/healthz probes performed by the operator.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(forgejo_operator_health_check_failures_total{namespace=\"$namespace\", name=\"$forgejo\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Last successful backup",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Age of the most recent successful ForgejoBackup (of any reason). Orange from one and a half schedule intervals on (a run was missed), red above the recovery point objective (RPO, two intervals), where ForgejoBackupTooOld fires.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(forgejo_operator_backup_last_success_timestamp_seconds{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": "__RPO_WARNING__"
              },
              {
                "color": "red",
                "value": "__RPO__"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Data volume used",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Highest used/capacity ratio across the instance's PVCs.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_operator_volume_used_ratio{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "Service level objectives",
      "id": 26,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Availability ($slo_window)",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of the operator's availability samples over the SLO window in which /api/healthz passed, without planned downtime (restores, orchestrated upgrades, spec.paused, zero replicas). Red below the objective.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - max(forgejo_slo:availability_error_ratio{namespace=\"$namespace\", name=\"$forgejo\", window=\"$slo_window\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": "__SLO_OBJECTIVE__"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "links": [
        {
          "title": "Runbook: ForgejoAvailabilityFastBurn",
          "url": "__RUNBOOKS__/ForgejoAvailabilityFastBurn.md",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Objective",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "spec.monitoring.slo.availabilityTarget over spec.monitoring.slo.window.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_slo:availability_objective{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Error budget remaining ($slo_window)",
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 - (error ratio over the SLO window / error budget). Below 0 the objective is missed for this window.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_slo:availability_error_budget_remaining{namespace=\"$namespace\", name=\"$forgejo\", window=\"$slo_window\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "links": [
        {
          "title": "Runbook: ForgejoAvailabilitySlowBurn",
          "url": "__RUNBOOKS__/ForgejoAvailabilitySlowBurn.md",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Recovery point age",
      "id": 30,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Age of the older recovery point: the last successful backup (local) and, with spec.backup.remote, the last verified upload (remote). Orange from one and a half schedule intervals on, red above the RPO (two intervals), where ForgejoBackupTooOld or ForgejoBackupUploadTooOld fires; the panel below shows both copies.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_slo:backup_recovery_point_age_seconds{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": "__RPO_WARNING__"
              },
              {
                "color": "red",
                "value": "__RPO__"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "links": [
        {
          "title": "Runbook: ForgejoBackupTooOld",
          "url": "__RUNBOOKS__/ForgejoBackupTooOld.md",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How fast the error budget is spent, in multiples of the sustainable rate (1 = the budget lasts exactly the SLO window), per window of the burn-rate alerts. The fast-burn page fires above 14.4 (and 6) over both its long and short window, the slow-burn ticket above 3 (and 1).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (window) (forgejo_slo:availability_burn_rate{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "{{window}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook: ForgejoAvailabilityFastBurn",
          "url": "__RUNBOOKS__/ForgejoAvailabilityFastBurn.md",
          "targetBlank": true
        },
        {
          "title": "Runbook: ForgejoAvailabilitySlowBurn",
          "url": "__RUNBOOKS__/ForgejoAvailabilitySlowBurn.md",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Availability samples",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "forgejo_operator_availability_probes_total per interval: up/down, and whether the sample fell into planned downtime (planned=true samples do not count against the SLO).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result, planned) (increase(forgejo_operator_availability_probes_total{namespace=\"$namespace\", name=\"$forgejo\"}[$__rate_interval]))",
          "legendFormat": "{{result}} planned={{planned}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Recovery point age vs. objective",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Age of the newest local and remote recovery point against the RPO (two schedule intervals). ForgejoBackupTooOld and ForgejoBackupUploadTooOld fire above the objective.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (copy) (forgejo_slo:backup_recovery_point_age_seconds{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "{{copy}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(forgejo_slo:backup_recovery_point_objective_seconds{namespace=\"$namespace\", name=\"$forgejo\"})",
          "legendFormat": "objective (RPO)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "objective (RPO)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
